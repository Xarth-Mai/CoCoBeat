    "native_defects": [
      "Valid tail targets N-1023 through N-1 are rejected because Ogg seek bound uses start_ts+num_frames with start_ts=-1024 and num_frames=N",
      "For requested frames 1..1023, required-1024 exceeds primer PTS=-1024 with valid duration=0, so demuxer skips primer and decoder.reset discards the packet covering frame 0..1023"
    ],
    "adaptation": "Request max(0,target-1024), then decode/reset normally and trim valid PCM to original target; target/request/actual remain separate",
    "limits": [
      "Linux only",
      "Not universal Vorbis seek admission",
      "Full-decode baselines are existing independently saved Symphonia and FFmpeg PCM, bound to this experiment by SHA-256",
      "No production integration, realtime device playback or listening"
    ],
