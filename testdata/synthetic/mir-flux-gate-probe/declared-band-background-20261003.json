    "peak_radius": 2,
    "minimum_change_inclusive": 0.5,
    "selection": "E>=0.5 and E>0, no larger value in clipped +-2, and no earlier exactly equal value in that neighborhood; winning band ties choose lowest index",
    "numeric_policy": "No additional epsilon, clamp, gain normalization, silence threshold, decay history, threshold sweep or confidence probability",
    "first_window": "Native flux remains zero without comparable prior spectrum; do not supply artificial previous samples or frame-zero candidates",
    "short_windows": "Clip both band boundaries to actual one-sided bin count; empty bands have zero mass/flux/ratio",
    "coordinates": "Existing real PCM support centers, including unchanged short/tail windows; no translated or averaged timestamps",
    "rationale": "Only add a denominator bound with magnitude units and bandwidth scaling to address observed sustained-tone side-lobe amplification; beta=.01 is an engineering hypothesis from seen development cases, not perceptual calibration or an external optimum",
    "relative_peak_floor": 0.01,
    "floor_formula": "P[i] is max native f32 single-bin magnitude over all real one-sided bins in clipped[i-2,i+2]; n[i,b] is actual clipped band bin count; floor[i,b]=n[i,b]*0.01*f64(P[i]); D_floor[i,b]=max(D[i,b],floor[i,b]); replace only D in old ratio and select exactly as before",
    "baseline_formula": "F[i,b] is unchanged native f32 positive magnitude-difference sum on each actual band slice; S[i,b] is f64 sum of f32 bin magnitudes; D=max S[j,b] for clipped j in [i-2,i+2]; R=F/D when D>0 else0; E=max_b R",
    "background_gate": {
      "radius": 8,
      "excess_inclusive": 0.5,
      "formula": "B[i]=arithmetic mean of unchanged floor E[j] for clipped j in[i-8,i+8], including current and actual zero values; accept old_floor_peak[i] iff E[i]>=B[i]+.5; never repick E-B",
      "boundary": "Clip to available real windows and divide by actual count, no padding",
      "rationale": "Reuse existing radius8 and change threshold.5 as one fixed normalized-excess gate; a local time baseline is independent from refractory; not literature-optimal parameters"
    }
  },
